# 공개 소개 사이트 라우팅.
#
# ⚠️ total-frontend 의 .htaccess 를 그대로 쓰면 안 된다.
#    이 사이트는 빌드 때 라우트별 정적 HTML 스냅샷(dist/<route>/index.html)을 굽는다.
#    그 스냅샷을 먼저 찾아 서빙해야 크롤러가 본문을 본다.
#    단순 SPA fallback 으로 두면 크롤러가 빈 껍데기를 보게 되고,
#    이 프로젝트를 따로 만든 의미가 사라진다.

<IfModule mod_rewrite.c>
	RewriteEngine On
	RewriteBase /

	# 1) 실제 파일은 그대로 (assets, sitemap.xml, robots.txt, 이미지 …)
	RewriteCond %{REQUEST_FILENAME} -f
	RewriteRule ^ - [L]

	# 2) 프리렌더 스냅샷이 있으면 그것을 서빙한다.
	#    mod_dir 에 맡기면 /about → /about/ 로 301 이 끼어
	#    sitemap 의 모든 URL 이 리다이렉트를 거치게 된다. 그래서 직접 rewrite 한다.
	RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
	RewriteRule ^(.+?)/?$ /$1/index.html [L]

	# 3) 그 외에는 SPA fallback (404 페이지 등)
	RewriteRule ^ /index.html [L]
</IfModule>

# 정적 자산은 장기 캐시, HTML·사이트맵은 캐시 금지(배포 즉시 반영)
<IfModule mod_headers.c>
	<FilesMatch "\.(js|css|woff2|png|jpg|jpeg|webp|svg|ico)$">
		Header set Cache-Control "public, max-age=31536000, immutable"
	</FilesMatch>
	<FilesMatch "\.(html|xml|txt)$">
		Header set Cache-Control "no-cache, must-revalidate"
	</FilesMatch>
</IfModule>
