# 공개 소개 사이트 라우팅.
#
# ⚠️ total-frontend 의 .htaccess 를 그대로 쓰면 안 된다.
#    이 사이트는 빌드 때 라우트별 정적 HTML 스냅샷(<route>/index.html)을 굽는다.
#    그 스냅샷을 먼저 찾아 서빙해야 크롤러가 본문을 본다.

# mod_dir 의 자동 301(/about → /about/)을 끈다.
#
# ⚠️ 이걸 켜 두면 사이트맵에 적힌 모든 URL 이 리다이렉트를 한 번씩 거친다.
#    아래 rewrite 가 스냅샷을 직접 서빙하므로 mod_dir 이 개입할 필요가 없다.
DirectorySlash Off

# DirectorySlash 를 끄면 디렉터리 목록이 노출될 수 있으므로 함께 막는다.
Options -Indexes

# 존재하지 않는 경로는 진짜 404 를 준다.
#
# ⚠️ 예전처럼 index.html 로 fallback 시키면 없는 주소가 200 으로 랜딩 페이지를
#    돌려준다(soft 404). 검색엔진이 중복 콘텐츠로 보고, 오타 URL 까지 색인된다.
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
	RewriteEngine On
	RewriteBase /

	# 1) 실제 파일은 그대로 (assets, sitemap.xml, robots.txt, 이미지 …)
	RewriteCond %{REQUEST_FILENAME} -f
	RewriteRule ^ - [L]

	# 2) 프리렌더 스냅샷이 있으면 그것을 서빙한다.
	RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
	RewriteRule ^(.+?)/?$ /$1/index.html [L]

	# 3) 루트
	RewriteRule ^$ /index.html [L]
</IfModule>

# 정적 자산은 장기 캐시, HTML·사이트맵은 캐시 금지(배포 즉시 반영)
<IfModule mod_headers.c>
	<FilesMatch "\.(js|css|woff2|png|jpg|jpeg|webp|svg|ico)$">
		Header set Cache-Control "public, max-age=31536000, immutable"
	</FilesMatch>
	<FilesMatch "\.(html|xml|txt)$">
		Header set Cache-Control "no-cache, must-revalidate"
	</FilesMatch>
</IfModule>
